# Configurações de Servidor
PORT=3000
NODE_ENV=development

# Autenticação Admin (Alterar em produção!)
ADMIN_USER=admin
ADMIN_PASS=seu_senha_super_segura_aqui

# Segurança - JWT
JWT_SECRET=seu_jwt_secret_aleatorio_muito_longo_aqui_mude_em_producao

# Segurança - HMAC
HMAC_SECRET=seu_hmac_secret_aleatorio_muito_longo_aqui_mude_em_producao

# Segurança - IP Whitelist (opcional)
# Apenas estes IPs podem acessar área admin
ADMIN_IPS=127.0.0.1,::1

# CORS - Origins permitidas
ALLOWED_ORIGINS=http://localhost:3000,https://inscricoes.planterr.uefs.br,https://admin.planterr.uefs.br

# Segurança - Rate Limiting
# Máximo de tentativas de login por janela
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# Máximo de requisições API por minuto
API_MAX_REQUESTS=100
API_WINDOW_MS=60000

# Emails para alertas de segurança
SECURITY_ALERTS_EMAIL=seguranca@planterr.uefs.br

# SMTP para enviar alertas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app_do_gmail
SMTP_FROM="Avalia Mais" <noreply@avalia.com>

# Notificações administrativas (inscrições/recursos)
# Aceita lista separada por vírgulas. Se vazio, o sistema usa SMTP_USER como fallback.
ADMIN_NOTIFY_TO=secretaria@planterr.uefs.br

# Redis (opcional, para rate limiting distribuído)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# URLs
SITE_URL=https://inscricoes.planterr.uefs.br
ADMIN_URL=https://inscricoes.planterr.uefs.br/secret/{UUID}/admin

# Modo Debug
DEBUG=false
